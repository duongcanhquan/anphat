rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn() && userDoc().active == true;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin() {
      return isActive() && (role() == 'admin' || role() == 'superadmin');
    }

    function isSuper() {
      return isActive() && role() == 'superadmin';
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isSuper() || (signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
      allow delete: if isSuper();
    }

    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /materials/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if isSuper();
    }

    match /stockEntries/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update, delete: if isSuper();
    }

    match /conversions/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /formulas/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /customers/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update: if isAdmin() && (
        resource.data.locked != true
        || isSuper()
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contractExported', 'locked', 'confirmedAt', 'confirmedBy', 'updatedAt'])
      );
      allow delete: if isSuper();
    }

    match /debtPayments/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update, delete: if isSuper();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn() && userExists() && userDoc().active == true;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin() {
      return isActive() && (role() == 'admin' || role() == 'superadmin');
    }

    function isSuper() {
      return isActive() && role() == 'superadmin';
    }

    // Super Admin > Admin > Viewer
    // Admin tạo/sửa tài khoản Admin dưới mình; không quản lý Viewer
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if
        // Bootstrap / tự tạo hồ sơ của chính mình
        (signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'active', 'createdAt'])
          && request.resource.data.active == true
          && request.resource.data.role in ['superadmin', 'admin', 'viewer'])
        // Superadmin tạo bất kỳ role
        || (isSuper()
          && request.resource.data.role in ['superadmin', 'admin', 'viewer']
          && request.resource.data.active == true)
        // Admin chỉ tạo Admin dưới mình
        || (isAdmin()
          && role() == 'admin'
          && request.resource.data.role == 'admin'
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuper()
        || (isAdmin()
          && role() == 'admin'
          && resource.data.role == 'admin'
          && request.resource.data.role == 'admin'
          && resource.data.role != 'viewer'
          && resource.data.role != 'superadmin')
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);

      allow delete: if isSuper()
        || (isAdmin()
          && role() == 'admin'
          && resource.data.role == 'admin'
          && resource.data.createdBy == request.auth.uid
          && userId != request.auth.uid);
    }

    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /materials/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if isSuper();
    }

    match /stockEntries/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update, delete: if isSuper();
    }

    match /conversions/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /formulas/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /customers/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update: if isAdmin() && (
        resource.data.locked != true
        || isSuper()
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contractExported', 'locked', 'confirmedAt', 'confirmedBy', 'updatedAt', 'status'])
      );
      allow delete: if isSuper();
    }

    match /debtPayments/{id} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update, delete: if isSuper();
    }
  }
}
